{
	"compilerOptions": {
		"target": "ES2020",
		"module": "commonjs",
		"lib": ["ES2020"],
		"outDir": "./extension",
		"rootDir": "./src/extension",
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"resolveJsonModule": true,
		"moduleResolution": "node",
		"types": ["node"],
		"typeRoots": [
			"../../types",
			"node_modules/@types"
		],
		"noEmitOnError": false
	},
	"include": [
		"src/extension/**/*"
	],
	"exclude": [
		"node_modules"
	]
}